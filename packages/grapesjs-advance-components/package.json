{
  "name": "grapesjs-advance-components",
  "version": "2.3.0",
  "description": "Ready-made, accessible GrapesJS blocks and components: forms that submit, Stripe checkout, multi-page export and bring-your-own-model AI block generation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/editor.d.ts",
        "default": "./dist/editor.js"
      },
      "require": {
        "types": "./dist/editor.d.cts",
        "default": "./dist/editor.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples/ai-server.mjs",
    "examples/render-site.mjs"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavBansal26/grapesjs-advance-components.git",
    "directory": "packages/grapesjs-advance-components"
  },
  "homepage": "https://github.com/VaibhavBansal26/grapesjs-advance-components#readme",
  "bugs": {
    "url": "https://github.com/VaibhavBansal26/grapesjs-advance-components/issues"
  },
  "keywords": [
    "ai",
    "blocks",
    "components",
    "forms",
    "grapesjs",
    "grapesjs-plugin",
    "page-builder",
    "stripe"
  ],
  "license": "MIT",
  "peerDependencies": {
    "grapesjs": ">=0.21.0"
  },
  "devDependencies": {
    "grapesjs": "^0.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
