{
  "name": "Site intake -> promptsite generate",
  "nodes": [
    {
      "parameters": {
        "content": "## Prompt to site\n\n1. Run the API next to n8n:\n`PROMPTSITE_API_TOKEN=<24+ random chars> promptsite serve --root ./sites`\n2. In n8n create two **Header Auth** credentials:\n   - *promptsite API*: name `Authorization`, value `Bearer <that token>`\n   - *Intake webhook*: any header name and a different random value\n3. Select them on the nodes below, activate, and POST `{ \"slug\": \"bakery\", \"brief\": \"...\" }` to the webhook.\n\n**Security:** never put the token in this workflow or in a form on a public page. Keep `promptsite serve` on localhost or behind TLS.",
        "height": 380,
        "width": 460
      },
      "id": "5b1c0a40-0000-4000-8000-000000000001",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "site-intake",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5b1c0a40-0000-4000-8000-000000000002",
      "name": "Intake webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        420,
        200
      ],
      "webhookId": "5b1c0a40-0000-4000-8000-0000000000a1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8787/v1/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $json.body.slug, brief: $json.body.brief, template: $json.body.template || 'landing', name: $json.body.name, accent: $json.body.accent, formEndpoint: $json.body.formEndpoint }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "5b1c0a40-0000-4000-8000-000000000003",
      "name": "Generate site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8787/v1/audit",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $json.slug }) }}",
        "options": {}
      },
      "id": "5b1c0a40-0000-4000-8000-000000000004",
      "name": "Audit site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ slug: $json.slug, passed: $json.passed, summary: $json.summary, bundle: '/v1/sites/' + $json.slug + '/bundle.zip' }) }}",
        "options": {}
      },
      "id": "5b1c0a40-0000-4000-8000-000000000005",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    }
  ],
  "connections": {
    "Intake webhook": {
      "main": [
        [
          {
            "node": "Generate site",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate site": {
      "main": [
        [
          {
            "node": "Audit site",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Audit site": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
